<Project>
	<PropertyGroup Label="Dependency Versions">
		<_CluedIn Condition="'$(_CluedIn)' == ''">5.0.0-*</_CluedIn>
		<_Humanizer>2.14.1</_Humanizer>
	</PropertyGroup>

	<ItemGroup>
		<!--
        Specified versions for dependencies across the solution

        MUST SPECIFY IN CSPROJ AS <PackageReference Name="<depName>" />
    -->
		<PackageReference Update="CluedIn.Core" Version="$(_CluedIn)" />
		<PackageReference Update="CluedIn.ExternalSearch" Version="$(_CluedIn)" />
		<PackageReference Update="CluedIn.Processing" Version="$(_CluedIn)" />
		<PackageReference Update="CluedIn.Processing.Web" Version="$(_CluedIn)" />
		<PackageReference Update="CluedIn.Processing.Web.TechnologyDetection" Version="$(_CluedIn)" />
		<PackageReference Update="Humanizer.Core" Version="$(_Humanizer)" />
	</ItemGroup>
</Project>
